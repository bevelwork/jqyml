<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{status} Bad Request</title>
</head>
<body>
  <h1>Error response</h1>
  <p><strong>Error code:</strong> {status}</p>
  <p><strong>Message:</strong> {message}</p>
  <p><strong>Error code explanation:</strong> {explanation}</p>
</body>
</html>
